# ============================================================
# TGM Mini CMS — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is git-ignored.
#
# These variables are server-side only. Do NOT prefix them
# with NEXT_PUBLIC_ — that would expose them to the browser.

# MongoDB connection string. Example values:
#   Local:   mongodb://127.0.0.1:27017
#   Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional — overrides the database name in MONGODB_URI.
MONGODB_DB=tgm_cms

# ------------------------------------------------------------
# Admin authentication
# ------------------------------------------------------------
# Secret used to sign the httpOnly admin session cookie (JWT).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Session lifetime (seconds). Defaults to 7 days.
# AUTH_SESSION_TTL=604800

# ------------------------------------------------------------
# Bootstrap admin — used ONLY by `npm run seed:admin` to create
# the first administrator. DEVELOPMENT VALUES — set strong
# credentials before any production deployment.
# ------------------------------------------------------------
ADMIN_EMAIL=admin@tgmchurch.org
ADMIN_PASSWORD=change-this-password
